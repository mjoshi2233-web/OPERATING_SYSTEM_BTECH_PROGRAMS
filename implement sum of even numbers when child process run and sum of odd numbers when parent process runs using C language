#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {

    pid_t pid;
    int n, i;
    int evenSum = 0, oddSum = 0;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    pid = fork();

    if (pid < 0) {
        printf("Fork failed!\n");
        return 1;
    }

    if (pid == 0) {

        printf("\n--- Child Process ---\n");

        for (i = 2; i <= n; i += 2) {
            evenSum += i;
        }

        printf("Sum of even numbers = %d\n", evenSum);
    }

    else {

        wait(NULL);

        printf("\n--- Parent Process ---\n");

        for (i = 1; i <= n; i += 2) {
            oddSum += i;
        }

        printf("Sum of odd numbers = %d\n", oddSum);
    }

    return 0;
}
